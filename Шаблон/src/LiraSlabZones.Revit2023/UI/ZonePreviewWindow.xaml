<Window x:Class="LiraSlabZones.Revit2023.UI.ZonePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LiraSlabZones.Revit2023.UI"
        Title="LiraSlabZones — предварительный просмотр зон"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">
  <Window.Resources>
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#1F2937"/>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryBtn">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Background" Value="#1D4ED8"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="Button" x:Key="SecondaryBtn">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Background" Value="#E5E7EB"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,2,12,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="280"/>
    </Grid.ColumnDefinitions>

    <!-- LEFT: settings -->
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
      <StackPanel>
        <TextBlock Text="LiraSlabZones" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
        <TextBlock TextWrapping="Wrap" Margin="0,2,0,10" Foreground="#6B7280"
                   Text="Превью зон доп.армирования (логика SmartRebar / SmartKR): фон, слои As1–As4, контур сопоставления."/>

        <GroupBox Header="Данные">
          <StackPanel>
            <Button Content="Демо-плита (пример)" Style="{StaticResource PrimaryBtn}" Click="BtnDemo_Click"/>
            <Button Content="Загрузить JSON…" Style="{StaticResource SecondaryBtn}" Click="BtnLoadJson_Click"/>
            <Button Content="Анализ ЛИРА (активная схема)" Style="{StaticResource SecondaryBtn}" Click="BtnAnalyzeLira_Click"/>
            <TextBlock x:Name="TxtSource" TextWrapping="Wrap" Foreground="#4B5563" FontSize="11"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Слои армирования">
          <StackPanel>
            <CheckBox x:Name="ChkAs1" Content="Нижняя по X (As1)" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <CheckBox x:Name="ChkAs2" Content="Нижняя по Y (As2)" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <CheckBox x:Name="ChkAs3" Content="Верхняя по X (As3)" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <CheckBox x:Name="ChkAs4" Content="Верхняя по Y (As4)" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Фоновое армирование (Ø / шаг)">
          <StackPanel>
            <TextBlock Text="Низ (As1 и As2)" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Ø, мм" FontSize="11" Foreground="#6B7280"/>
                <ComboBox x:Name="CmbBgBotD" Height="26" SelectionChanged="SettingsChanged">
                  <ComboBoxItem Content="—" IsSelected="True"/>
                  <ComboBoxItem Content="8"/><ComboBoxItem Content="10"/><ComboBoxItem Content="12"/>
                  <ComboBoxItem Content="16"/><ComboBoxItem Content="20"/><ComboBoxItem Content="22"/>
                  <ComboBoxItem Content="25"/><ComboBoxItem Content="28"/><ComboBoxItem Content="32"/>
                  <ComboBoxItem Content="36"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Шаг, мм" FontSize="11" Foreground="#6B7280"/>
                <ComboBox x:Name="CmbBgBotStep" Height="26" SelectionChanged="SettingsChanged">
                  <ComboBoxItem Content="—" IsSelected="True"/>
                  <ComboBoxItem Content="100"/><ComboBoxItem Content="150"/><ComboBoxItem Content="200"/>
                </ComboBox>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="TxtBgBotAs" Text="As низа = —" FontSize="11" Foreground="#6B7280" Margin="0,0,0,8"/>

            <TextBlock Text="Верх (As3 и As4)" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Ø, мм" FontSize="11" Foreground="#6B7280"/>
                <ComboBox x:Name="CmbBgTopD" Height="26" SelectionChanged="SettingsChanged">
                  <ComboBoxItem Content="—" IsSelected="True"/>
                  <ComboBoxItem Content="8"/><ComboBoxItem Content="10"/><ComboBoxItem Content="12"/>
                  <ComboBoxItem Content="16"/><ComboBoxItem Content="20"/><ComboBoxItem Content="22"/>
                  <ComboBoxItem Content="25"/><ComboBoxItem Content="28"/><ComboBoxItem Content="32"/>
                  <ComboBoxItem Content="36"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Шаг, мм" FontSize="11" Foreground="#6B7280"/>
                <ComboBox x:Name="CmbBgTopStep" Height="26" SelectionChanged="SettingsChanged">
                  <ComboBoxItem Content="—" IsSelected="True"/>
                  <ComboBoxItem Content="100"/><ComboBoxItem Content="150"/><ComboBoxItem Content="200"/>
                </ComboBox>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="TxtBgTopAs" Text="As верха = —" FontSize="11" Foreground="#6B7280"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Автораскладка зон">
          <StackPanel>
            <TextBlock x:Name="TxtLayoutGate" TextWrapping="Wrap" Foreground="#B45309" Margin="0,0,0,6"
                       Text="Допки не раскладываются, пока не выбрана плита, не задан фон (низ+верх) и класс бетона."/>
            <CheckBox x:Name="ChkAutoLayout" Content="Автораскладка (SUM-30…34)" IsChecked="True"
                      Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <TextBlock Text="Детализация: Max → Min (как в настройках увязки)"/>
            <Slider x:Name="SldDetail" Minimum="0" Maximum="1" Value="0"
                    TickFrequency="0.25" IsSnapToTickEnabled="True"
                    Ticks="0,0.25,0.5,0.75,1"
                    ValueChanged="DetailChanged"/>
            <TextBlock x:Name="TxtDetail" Text="Max" HorizontalAlignment="Right" Foreground="#6B7280"/>
            <TextBlock Text="Max · 4 · 3 · 2 · Min" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Stretch"/>
            <CheckBox x:Name="ChkBarStep100" Content="Расставлять зоны с шагом 100 мм"
                      Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            <TextBlock Text="Класс бетона (анкеровка → длина SUM-3)"/>
            <ComboBox x:Name="CmbConcrete" Height="26" Margin="0,0,0,4" SelectionChanged="SettingsChanged">
              <ComboBoxItem Content="—" IsSelected="True"/>
              <ComboBoxItem Content="B15"/><ComboBoxItem Content="B20"/>
              <ComboBoxItem Content="B25"/>
              <ComboBoxItem Content="B30"/><ComboBoxItem Content="B35"/><ComboBoxItem Content="B40"/>
            </ComboBox>
            <TextBlock Text="Длины зон SUM-3, мм:" FontSize="11" Foreground="#6B7280"/>
            <TextBlock Text="1460 · 1950 · 2340 · 2900 · 3900 · 4680 · 5850 · 7800 · 8800 · 11700"
                       FontSize="10" TextWrapping="Wrap" Foreground="#9CA3AF" Margin="0,0,0,4"/>
            <TextBlock Text="Ячейка мозаики, мм"/>
            <TextBox x:Name="TbGridCell" Text="300" LostFocus="SettingsChanged"/>
            <TextBlock Text="Толщина плиты / защитные слои, мм"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TbThick" Text="200" LostFocus="SettingsChanged" ToolTip="Толщина"/>
              <TextBox Grid.Column="1" x:Name="TbCoverBot" Text="25" LostFocus="SettingsChanged" ToolTip="Низ"/>
              <TextBox Grid.Column="2" x:Name="TbCoverTop" Text="25" LostFocus="SettingsChanged" ToolTip="Верх"/>
            </Grid>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Параметры зон / изополя">
          <StackPanel>
            <TextBlock Text="Мин. ширина зоны, мм (0 = нет)"/>
            <TextBox x:Name="TbMinW" Text="0" LostFocus="SettingsChanged"
                     ToolTip="Как в SmartRebar. Пример: 800"/>
            <TextBlock Text="Макс. ширина зоны, мм (0 = нет)"/>
            <TextBox x:Name="TbMaxW" Text="0" LostFocus="SettingsChanged"
                     ToolTip="Ограничение ширины перпендикулярно стержням. Пример: 2000"/>
            <TextBlock Text="Мин. длина зоны, мм (0 = SUM-3 мин.)"/>
            <TextBox x:Name="TbMinL" Text="0" LostFocus="SettingsChanged"
                     ToolTip="Минимальная длина стержня с анкеровкой. Пример: 1460 или 1950"/>
            <TextBlock Text="Мин. число КЭ в зоне (0 = нет)"/>
            <TextBox x:Name="TbMinFe" Text="0" LostFocus="SettingsChanged"/>
            <TextBlock Text="Шаг As изополей, см²/м (интервал цвета)"/>
            <Slider x:Name="SldVis" Minimum="0" Maximum="25" Value="1" TickFrequency="1"
                    IsSnapToTickEnabled="True" ValueChanged="SettingsChanged"/>
            <TextBlock x:Name="TxtVis" Text="1" HorizontalAlignment="Right" Foreground="#6B7280"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Отметка / уровень">
          <StackPanel>
            <TextBlock Text="Уровни из файла ЛИРА" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbLevels" Height="26" Margin="0,0,0,6"/>
            <Button Content="Загрузить уровни из ЛИРЫ" Style="{StaticResource SecondaryBtn}" Click="BtnLoadLevels_Click"/>
            <Button Content="Взять плиту ближайшую к уровню" Style="{StaticResource PrimaryBtn}" Click="BtnApplyLevel_Click"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Сопоставление контура (Revit)">
          <StackPanel>
            <CheckBox x:Name="ChkShowMesh" Content="Сетка КЭ (как в ЛИРЕ)" IsChecked="True" Checked="Redraw" Unchecked="Redraw"/>
            <CheckBox x:Name="ChkShowIso" Content="Изополя As (фон КЭ)" IsChecked="True" Checked="Redraw" Unchecked="Redraw"/>
            <CheckBox x:Name="ChkShowAxes" Content="Оси из ЛИРЫ" IsChecked="False" Checked="Redraw" Unchecked="Redraw"/>
            <TextBlock Text="Смещение X, м"/>
            <TextBox x:Name="TbOffX" Text="0" LostFocus="TransformChanged"/>
            <TextBlock Text="Смещение Y, м"/>
            <TextBox x:Name="TbOffY" Text="0" LostFocus="TransformChanged"/>
            <TextBlock Text="Поворот, °"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TbRot" Text="0" LostFocus="TransformChanged"/>
              <Button Grid.Column="1" Content="↺" Width="32" Margin="4,0,2,0" ToolTip="Против часовой (−90°)"
                      Style="{StaticResource SecondaryBtn}" Click="BtnRotateCcw_Click"/>
              <Button Grid.Column="2" Content="↻" Width="32" Margin="2,0,0,0" ToolTip="По часовой (+90°)"
                      Style="{StaticResource SecondaryBtn}" Click="BtnRotateCw_Click"/>
            </Grid>
            <Button Content="Выровнять по осям" Style="{StaticResource SecondaryBtn}" Click="BtnAlignAxes_Click"/>
            <Button Content="Сбросить положение" Style="{StaticResource SecondaryBtn}" Click="BtnResetTransform_Click"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Действия">
          <StackPanel>
            <Button Content="Пересчитать зоны" Style="{StaticResource PrimaryBtn}" Click="BtnRebuild_Click"/>
            <Button Content="Сохранить JSON зон…" Style="{StaticResource SecondaryBtn}" Click="BtnSaveJson_Click"/>
            <Button Content="Сохранить JSON всех плит…" Style="{StaticResource SecondaryBtn}" Click="BtnSaveAllPlatesJson_Click"/>
            <Button x:Name="BtnPlace" Content="Разместить в Revit" Style="{StaticResource PrimaryBtn}" Click="BtnPlace_Click" IsEnabled="False"/>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <!-- CENTER: canvas -->
    <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1" Background="White" CornerRadius="2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="8,6">
          <TextBlock x:Name="TxtTitle" Text="Плита — превью" FontWeight="SemiBold" FontSize="14"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="−" Width="28" Margin="0,0,4,0" Click="BtnZoomOut_Click" ToolTip="Отдалить"/>
            <Button Content="+" Width="28" Margin="0,0,4,0" Click="BtnZoomIn_Click" ToolTip="Приблизить"/>
            <Button Content="100%" Width="44" Margin="0,0,4,0" Click="BtnZoomReset_Click" ToolTip="Сброс масштаба"/>
            <Button Content="Вписать" Width="56" Margin="0,0,12,0" Click="BtnZoomFit_Click" ToolTip="Вписать в окно"/>
            <TextBlock x:Name="TxtZoom" Text="100%" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#6B7280"/>
            <Border Width="14" Height="14" Background="#2563EB" Margin="8,0,4,0"/>
            <TextBlock Text="As1" Margin="0,0,10,0"/>
            <Border Width="14" Height="14" Background="#059669" Margin="0,0,4,0"/>
            <TextBlock Text="As2" Margin="0,0,10,0"/>
            <Border Width="14" Height="14" Background="#D97706" Margin="0,0,4,0"/>
            <TextBlock Text="As3" Margin="0,0,10,0"/>
            <Border Width="14" Height="14" Background="#DC2626" Margin="0,0,4,0"/>
            <TextBlock Text="As4"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="PreviewScroll" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled">
          <local:PreviewViewport x:Name="Viewport"
                                 Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                 Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
        </ScrollViewer>
        <StatusBar Grid.Row="2" Background="#F9FAFB">
          <StatusBarItem>
            <TextBlock x:Name="TxtStatus" Text="Загрузите демо или JSON"/>
          </StatusBarItem>
        </StatusBar>
      </Grid>
    </Border>

    <!-- RIGHT: info -->
    <DockPanel Grid.Column="2" Margin="8,0,0,0">
      <GroupBox Header="ТЭПы / статистика" DockPanel.Dock="Top">
        <StackPanel>
          <TextBlock x:Name="TxtStats" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="Журнал" DockPanel.Dock="Bottom" Height="160">
        <ListBox x:Name="LstLog" FontSize="11"/>
      </GroupBox>
      <GroupBox Header="Выбранная зона" >
        <StackPanel>
          <TextBlock x:Name="TxtZoneInfo" TextWrapping="Wrap" FontSize="12" Text="Кликните зону на холсте"/>
        </StackPanel>
      </GroupBox>
    </DockPanel>
  </Grid>
</Window>
